# Enquiry form mail delivery
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit
# real credentials. Without these the form still works: it falls back to
# handing the visitor a pre-filled `mailto:`, and says so.
#
# Restart the dev server after changing anything here.

# Where enquiries are delivered.
#
# NEXT_PUBLIC_ENQUIRY_TO is read by both halves: the server action mails to it,
# and the form's `mailto:` fallback addresses it. Set this one and the two
# paths cannot disagree. ENQUIRY_TO overrides it server-side only, which is
# useful for pointing staging somewhere harmless.
NEXT_PUBLIC_ENQUIRY_TO=yewen1028@gmail.com
ENQUIRY_TO=yewen1028@gmail.com

# --- SMTP ---------------------------------------------------------------
#
# Gmail: SMTP_PASS must be a 16-character App Password, not the account
# password. Generate one at https://myaccount.google.com/apppasswords with
# 2-Step Verification enabled. Gmail rejects plain passwords over SMTP.
#
# Port 587 is STARTTLS, port 465 is implicit TLS. The code sets `secure`
# from the port, so just set the port your provider documents.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yewen1028@gmail.com
SMTP_PASS=

# The envelope sender. Must be an address the SMTP account may send as, so for
# Gmail this has to be SMTP_USER. The visitor's own address is set as Reply-To,
# so replying from the inbox still reaches them.
SMTP_FROM=yewen1028@gmail.com

# --- Switching provider -------------------------------------------------
#
# Any SMTP host works; only these values change. For example:
#
#   Microsoft 365   SMTP_HOST=smtp.office365.com     SMTP_PORT=587
#   Google Workspace SMTP_HOST=smtp.gmail.com        SMTP_PORT=587
#   Resend          SMTP_HOST=smtp.resend.com        SMTP_PORT=465
#                   SMTP_USER=resend                 SMTP_PASS=<api key>
#   SendGrid        SMTP_HOST=smtp.sendgrid.net      SMTP_PORT=587
#                   SMTP_USER=apikey                 SMTP_PASS=<api key>
#
# For production on hpe.com.my, prefer a provider with SPF and DKIM configured
# on the domain. Sending as a Gmail address from a server is fine for testing
# but will land in spam more often than a properly authenticated domain.
